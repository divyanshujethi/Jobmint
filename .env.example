# ==============================================================================
# JOBMINT ENVIRONMENT VARIABLES (ZERO-COST ARCHITECTURE)
# ==============================================================================

# 1. DATABASE (PostgreSQL - Supabase / Neon / Oracle Cloud Free Tier)
# Example: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobmint"

# 2. AUTHENTICATION (Auth.js / NextAuth)
# Generate a secret: `openssl rand -base64 32` or any random 32+ char string
AUTH_SECRET="super-secret-auth-key-change-in-production-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (Google Cloud Console - 100% Free)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# 3. OBJECT STORAGE (Cloudflare R2 - S3 API Compatible - 10GB Free, 0 Egress)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="jobmint-resumes"
# R2_PUBLIC_DOMAIN=""

# 4. TRANSACTIONAL EMAIL GATEWAY (Resend - Primary; Brevo - Fallback)
# RESEND_API_KEY="re_..."
# RESEND_SENDER_EMAIL="alert@mail.rolenest.in"
# RESEND_SENDER_NAME="Role Nest"
# BREVO_API_KEY=""
# EMAIL_FROM="Role Nest <alert@mail.rolenest.in>"

# 5. AI GATEWAY (Google Gemini Flash - Free in Google AI Studio)
# GEMINI_API_KEY=""
# GROQ_API_KEY=""

# 6. SENTRY ERROR MONITORING
NEXT_PUBLIC_SENTRY_DSN="https://53c674f338af7a34d433def785f1bd15@o4512144533618688.ingest.us.sentry.io/4512144535846912"
SENTRY_DSN="https://53c674f338af7a34d433def785f1bd15@o4512144533618688.ingest.us.sentry.io/4512144535846912"

