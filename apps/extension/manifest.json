{
  "manifest_version": 3,
  "name": "Track with RoleNest",
  "version": "1.0.0",
  "description": "1-Click save any tech job application from LinkedIn, Greenhouse, Lever, and career portals into your RoleNest journal.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track with RoleNest",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://rolenest.in/*",
    "http://localhost:3000/*"
  ]
}
