{
  "expo": {
    "name": "Role Nest",
    "slug": "rolenest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rolenest.app"
    },
    "android": {
      "package": "com.rolenest.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}