{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "react": ["../web/node_modules/@types/react"],
      "react/jsx-runtime": ["../web/node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.ts"]
}