# ==============================================================================
# JobMint Production Environment Variables (OCI + Cloudflare Zero-Cost Stack)
# ==============================================================================

# Node Environment
NODE_ENV=production

# App URLs
NEXT_PUBLIC_APP_URL=https://jobmint.yourdomain.com
AUTH_URL=https://jobmint.yourdomain.com
NEXTAUTH_SECRET=generate_a_random_64_char_hex_secret_here

# 1. Database (PostgreSQL 16 on OCI VM)
DATABASE_URL=postgresql://jobmint:JobMintSecurePass2026!@localhost:5432/jobmint_prod

# 2. Redis (Cache & BullMQ Queue on OCI VM)
REDIS_URL=redis://:JobMintRedisPass2026!@localhost:6379

# 3. OCI 200 GB Local Resume Storage Engine
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/resumes
STORAGE_SECRET=generate_a_secure_hmac_sha256_storage_secret

# Optional Fallback: Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jobmint-resumes

# 4. 4-Tier Llama 3.2 AI Cascade
# Tier 1: Groq Free API (14,400 req/day free, 300 tok/sec)
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Tier 2: Cloudflare Workers AI Free Tier (10,000 neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Tier 3: OCI Always Free VM Ollama (Self-Hosted Llama 3.2 3B, $0, 0 limits)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Tier 4: Google Gemini Flash Free Tier (1,500 req/day)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# 5. Email Gateway (Resend 3,000 free emails/mo or Brevo 9,000/mo)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_free_resend_api_key
FROM_EMAIL=notifications@jobmint.yourdomain.com